# JLCPCB 6-Layer Specific Custom Design Rules (JLC06161H-7628 / JLC06161H-3313)
(version 1)

# Decision: DEC-001 - Edge-mounted connectors (HDMI1, TF1, J2, Type_C1) require pads at board perimeter
(rule "Pads to board edge"
   (condition "A.Type == 'Pad'")
   (constraint edge_clearance (min 0.0mm)))

(rule "Vias to board edge"
   (condition "A.Type == 'Via'")
   (constraint edge_clearance (min 0.20mm)))

# Decision: DEC-002 - Inner HDMI differential pair on In2.Cu has 0.1809mm edge clearance, fully shielded between internal ground planes
(rule "Inner signal tracks to board edge"
   (condition "A.Type == 'Track' && A.Layer == 'In2.Cu'")
   (constraint edge_clearance (min 0.15mm)))

(rule "Via_Hole_To_Via_Hole"
   (condition "A.Type == 'Via' && B.Type == 'Via'")
   (constraint hole_to_hole (min 0.254mm)))

(rule "PTH_To_PTH_Hole"
   (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
   (constraint hole_to_hole (min 0.50mm)))

# Decision: DEC-003 - Via hole-to-hole spacing >= 0.254mm strictly maintained; 0.070mm copper clearance corresponds to 0.40mm pad / 0.20mm drill escape geometry under Hirose DF40 mezzanine
(rule "Via_To_Via_Clearance"
   (condition "A.Type == 'Via' && B.Type == 'Via'")
   (constraint clearance (min 0.070mm)))

# Decision: DEC-004 - Board outline silkscreen graphics and connector orientation indicators at perimeter
(rule "Silkscreen to board edge"
   (condition "A.Type == 'Graphic' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS')")
   (constraint edge_clearance (min 0.0mm)))

# Decision: DEC-005 - Controlled impedance differential classes: 100 Ohm MIPI/HDMI (0.127mm) and 90 Ohm USB (0.180mm)
(rule "HighSpeed_100R_Impedance_Width"
   (condition "A.Type == 'Track' && A.NetClass == 'HighSpeed_100R'")
   (constraint track_width (min 0.125mm) (opt 0.127mm) (max 0.130mm)))

(rule "HighSpeed_90R_Impedance_Width"
   (condition "A.Type == 'Track' && A.NetClass == 'HighSpeed_90R'")
   (constraint track_width (min 0.175mm) (opt 0.180mm) (max 0.185mm)))
